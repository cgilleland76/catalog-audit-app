# Copy to .env for local development. Never commit .env.
# Netlify → your project → Extensions/Database (Neon) → connection strings,
# or run `npx netlify env:get NETLIFY_DATABASE_URL` after `npx netlify link`.
# Pooled connection, used by the app:
NETLIFY_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Unpooled connection, used for migrations:
NETLIFY_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Encrypts stored warehouse credentials. Any long random string; keep it the same everywhere.
CREDENTIALS_KEY=""
