// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" for your computer, rhel-openssl-3.0.x for Netlify Functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// Supabase Postgres. DATABASE_URL is the pooled connection (port 6543,
// ?pgbouncer=true) used by the app; DIRECT_URL (port 5432) runs migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Credentials for a warehouse system (ShipHero, ...), one per shop and provider.
// `credentials` is AES-256-GCM encrypted JSON; see app/lib/crypto.server.ts.
model WmsConnection {
  id          String   @id @default(cuid())
  shop        String
  provider    String
  credentials String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, provider])
}

// One Shopify-vs-WMS comparison. Serverless requests can only run for a few
// seconds, so it advances in steps: each step looks up the next SKUs and saves
// progress here. Pages call a step while they poll.
model WmsComparison {
  id          String    @id @default(cuid())
  shop        String
  provider    String
  status      String // running | done | failed
  skus        String? // JSON array of SKUs to look up
  found       String? // JSON object: lower-cased SKU -> WmsProduct
  checked     Int       @default(0)
  total       Int       @default(0)
  error       String?
  results     String? // JSON array of mismatches
  lockedUntil DateTime? // a step is running until this time
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([shop, provider, startedAt])
}

// A snapshot of the shop's catalog, read with a Shopify bulk operation.
// Every page works from the latest finished scan.
model CatalogScan {
  id              String    @id @default(cuid())
  shop            String
  status          String // running | done | failed
  bulkOperationId String?
  objectCount     Int       @default(0)
  rowCount        Int       @default(0)
  rows            String? // JSON array of CatalogRow
  error           String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([shop, startedAt])
}
