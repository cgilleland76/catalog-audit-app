// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" for your computer, rhel-openssl-3.0.x for Netlify Functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// Netlify Database (built-in Postgres), provided to the running app as
// NETLIFY_DB_URL (see app/db.server.ts). Tables are created by the app itself
// from app/lib/migrations.server.ts; keep that in step with this file.
datasource db {
  provider = "postgresql"
  url      = env("NETLIFY_DB_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Credentials for a warehouse system (ShipHero, ...), one per shop and provider.
// `credentials` is AES-256-GCM encrypted JSON; see app/lib/crypto.server.ts.
model WmsConnection {
  id          String   @id @default(cuid())
  shop        String
  provider    String
  credentials String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, provider])
}

// One Shopify-vs-WMS comparison. Serverless requests can only run for a few
// seconds, so it advances in steps: each step looks up the next SKUs and saves
// progress here. Pages call a step while they poll.
model WmsComparison {
  id          String    @id @default(cuid())
  shop        String
  provider    String
  status      String // running | done | failed
  skus        String? // JSON array of SKUs to look up
  found       String? // JSON object: lower-cased SKU -> WmsProduct
  checked     Int       @default(0)
  total       Int       @default(0)
  error       String?
  results     String? // JSON array of mismatches
  cursor      String? // where a catalog-paging lookup resumes
  lockedUntil DateTime? // a step is running until this time
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([shop, provider, startedAt])
}

// A snapshot of the shop's catalog, read with a Shopify bulk operation.
// Every page works from the latest finished scan.
model CatalogScan {
  id              String    @id @default(cuid())
  shop            String
  status          String // running | done | failed
  bulkOperationId String?
  objectCount     Int       @default(0)
  rowCount        Int       @default(0)
  rows            String? // JSON array of CatalogRow
  error           String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([shop, startedAt])
}

// Changes SKU Doctor wrote to Shopify from a warehouse comparison, kept so
// they can be undone. Applying and undoing advance in steps, like comparisons.
model FixBatch {
  id           String    @id @default(cuid())
  shop         String
  provider     String
  comparisonId String?
  source       String // manual | sync
  status       String // applying | done | failed | undoing | undone
  total        Int       @default(0)
  applied      Int       @default(0)
  failed       Int       @default(0)
  reverted     Int       @default(0)
  kept         Int       @default(0) // not undone: changed in Shopify since
  error        String?
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?
  undoneAt     DateTime?

  @@index([shop, provider, createdAt])
}

// One field of one variant in a FixBatch. Values are JSON: weight
// { value, unit } (newValue { lb }), cost number, barcode string; null = empty.
model FixItem {
  id        String  @id @default(cuid())
  shop      String
  batchId   String
  variantId String
  productId String
  sku       String
  label     String
  field     String // weight | cost | barcode
  newValue  String
  oldValue  String? // Shopify's value just before the change
  status    String  @default("pending") // pending | applied | unchanged | failed | reverted | kept | undo_failed
  error     String?

  @@index([batchId, status])
  @@index([shop])
}

// Scheduled sync for one warehouse connection: re-read the catalog, compare,
// and optionally fix chosen fields in Shopify. Run by a Netlify scheduled
// function (netlify/functions/scheduled-sync.mjs → /internal/sync).
model SyncSetting {
  id           String    @id @default(cuid())
  shop         String
  provider     String
  enabled      Boolean   @default(false)
  frequency    String    @default("daily") // 6h | daily | weekly
  fixFields    String    @default("[]") // JSON array of weight | cost | barcode
  stage        String    @default("idle") // idle | scanning | comparing | fixing
  scanId       String?
  comparisonId String?
  fixBatchId   String?
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  lastStatus   String? // done | failed | skipped
  lastMessage  String?
  updatedAt    DateTime  @updatedAt

  @@unique([shop, provider])
  @@index([enabled, nextRunAt])
}
