// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" for your computer, rhel-openssl-3.0.x for Netlify Functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// Netlify Database (built-in Postgres), provided to the running app as
// NETLIFY_DB_URL (see app/db.server.ts). Tables are created by the app itself
// from app/lib/migrations.server.ts; keep that in step with this file.
datasource db {
  provider = "postgresql"
  url      = env("NETLIFY_DB_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Credentials for a warehouse system (ShipHero, ...), one per shop and provider.
// `credentials` is AES-256-GCM encrypted JSON; see app/lib/crypto.server.ts.
model WmsConnection {
  id          String   @id @default(cuid())
  shop        String
  provider    String
  credentials String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, provider])
}

// One Shopify-vs-WMS comparison of a catalog scan. Serverless requests can
// only run for a few seconds, so it advances in steps: first looking SKUs up in
// the warehouse (stage "lookup", results in WmsFound), then comparing variants
// in batches (stage "compare", differences in WmsMismatch).
model WmsComparison {
  id            String    @id @default(cuid())
  shop          String
  provider      String
  scanId        String
  scope         String    @default("active") // active | active_draft
  status        String // running | done | failed
  stage         String    @default("lookup") // lookup | compare
  checked       Int       @default(0) // SKUs looked up
  total         Int       @default(0) // distinct SKUs to look up
  skuCursor     String? // last SKU key looked up (per-SKU systems)
  cursor        String? // where a catalog-paging lookup resumes
  rowCursor     BigInt    @default(0) // last CatalogVariant id compared
  maxRowId      BigInt? // plan limit: variants after this id are left out
  mismatchCount Int       @default(0)
  error         String?
  lockedUntil   DateTime? // a step is running until this time
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([shop, provider, startedAt])
}

// A product found in the warehouse during a comparison's lookup stage.
model WmsFound {
  id           BigInt @id @default(autoincrement())
  comparisonId String
  skuKey       String // lower-cased, trimmed SKU
  data         String // JSON WmsProduct

  @@unique([comparisonId, skuKey])
}

// One difference a comparison found. `target` is the warehouse's value as
// JSON (pounds, cost or barcode), used by Fix in Shopify.
model WmsMismatch {
  id           BigInt  @id @default(autoincrement())
  comparisonId String
  shop         String
  code         String
  variantId    String
  productId    String
  label        String
  sku          String
  shopify      String
  wms          String
  target       String?

  @@index([comparisonId, code, id])
  @@index([comparisonId, variantId])
  @@index([shop])
}

// A snapshot of the shop's active and draft variants, read with a Shopify bulk
// operation (running), then imported from its JSONL file a few megabytes per
// step (importing) into CatalogVariant. Pages work from the latest done scan.
model CatalogScan {
  id              String    @id @default(cuid())
  shop            String
  status          String // running | importing | done | failed
  bulkOperationId String?
  url             String? // the export file, while importing
  fileSize        BigInt    @default(0)
  importOffset    BigInt    @default(0) // bytes imported so far
  objectCount     Int       @default(0)
  rowCount        Int       @default(0)
  error           String?
  lockedUntil     DateTime? // an import step is running until this time
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([shop, startedAt])
}

// One variant of a catalog scan (see CatalogRow in app/lib/catalog.ts).
model CatalogVariant {
  id                BigInt  @id @default(autoincrement())
  shop              String
  scanId            String
  variantId         String
  variantTitle      String
  productId         String
  productTitle      String
  handle            String
  status            String
  vendor            String
  productType       String
  tags              String // JSON array
  imageUrl          String?
  sku               String?
  skuKey            String? // lower-cased, trimmed SKU
  barcode           String?
  price             Float
  compareAtPrice    Float?
  cost              Float?
  weight            Float?
  weightUnit        String?
  requiresShipping  Boolean
  inventoryQuantity Int?

  @@index([scanId, id])
  @@index([scanId, skuKey])
  @@index([scanId, variantId])
  @@index([shop])
}

// Changes SKU Doctor wrote to Shopify from a warehouse comparison, kept so
// they can be undone. Applying and undoing advance in steps, like comparisons.
model FixBatch {
  id           String    @id @default(cuid())
  shop         String
  provider     String
  comparisonId String?
  source       String // manual | sync
  status       String // applying | done | failed | undoing | undone
  total        Int       @default(0)
  applied      Int       @default(0)
  failed       Int       @default(0)
  reverted     Int       @default(0)
  kept         Int       @default(0) // not undone: changed in Shopify since
  error        String?
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?
  undoneAt     DateTime?

  @@index([shop, provider, createdAt])
}

// One field of one variant in a FixBatch. Values are JSON: weight
// { value, unit } (newValue { lb }), cost number, barcode string; null = empty.
model FixItem {
  id        String  @id @default(cuid())
  shop      String
  batchId   String
  variantId String
  productId String
  sku       String
  label     String
  field     String // weight | cost | barcode
  newValue  String
  oldValue  String? // Shopify's value just before the change
  status    String  @default("pending") // pending | applied | unchanged | failed | reverted | kept | undo_failed
  error     String?

  @@index([batchId, status])
  @@index([shop])
}

// Scheduled sync for one warehouse connection: re-read the catalog, compare,
// and optionally fix chosen fields in Shopify. Run by a Netlify scheduled
// function (netlify/functions/scheduled-sync.mjs → /internal/sync).
model SyncSetting {
  id           String    @id @default(cuid())
  shop         String
  provider     String
  enabled      Boolean   @default(false)
  frequency    String    @default("daily") // 6h | daily | weekly
  fixFields    String    @default("[]") // JSON array of weight | cost | barcode
  scope        String    @default("active") // active | active_draft
  stage        String    @default("idle") // idle | scanning | comparing | fixing
  scanId       String?
  comparisonId String?
  fixBatchId   String?
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  lastStatus   String? // done | failed | skipped
  lastMessage  String?
  runId        String? // the SyncRun in progress
  leaseUntil   DateTime? // a background worker owns this sync until then
  updatedAt    DateTime  @updatedAt

  @@unique([shop, provider])
  @@index([enabled, nextRunAt])
}

// One scheduled sync run, for the History page (including runs that were
// skipped or failed before a comparison started).
model SyncRun {
  id           String    @id @default(cuid())
  shop         String
  provider     String
  status       String // running | done | failed | skipped
  message      String?
  comparisonId String?
  fixBatchId   String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([shop, startedAt])
}
